{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "types": ["svelte", "vite/client"],
    "skipLibCheck": true,
    "noEmit": true,

    "allowJs": true,
    "checkJs": true,
    "moduleDetection": "force",

    "paths": {
      "@elements": ["./src/elements"],
      "@elements/*": ["./src/elements/*"],
      "@pages": ["./src/pages"],
      "@pages/*": ["./src/pages/*"],
      "@styles/*": ["./src/styles/*"],
      "@pitch/meta": ["./src/pages/component/meta.ts"],
      "@pitch/css": ["./src/scripts/css/"],
      "@db": ["./src/storage/db.ts"],
      "@utils": ["./src/scripts/utils"],
      "@runtime": ["./src/runtime"],
      "@runtime/*": ["./src/runtime/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.svelte"
  ]
}
